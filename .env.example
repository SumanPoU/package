# @itzsa/captcha — production security (Next.js docs / app)
# Copy to .env.local for local development:  cp .env.example .env.local

# Required in production — HMAC for humanPass + renderStamp tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_HMAC_SECRET=

# Optional — Cloudflare Turnstile siteverify secret
# Soft-skipped when unset outside production
TURNSTILE_SECRET_KEY=

# Optional — Redis URL for challenge / rate-limit store
# Falls back to in-memory when unset (fine for single-instance docs)
REDIS_URL=

# Optional — minimum ms between challenge issue and verify (bot-speed filter)
CAPTCHA_MIN_SOLVE_MS=800

# Optional — maximum ms a challenge remains solvable (default 5 minutes)
# CAPTCHA_MAX_SOLVE_MS=300000
