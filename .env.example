# itzsa docs / demo app — copy to .env.local
# cp .env.example .env.local
#
# Never commit real secrets. See SECURITY.md.

# ── Captcha (required in production) ─────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_HMAC_SECRET=

# Optional — Cloudflare Turnstile siteverify secret
TURNSTILE_SECRET_KEY=

# Optional — Redis for challenge / rate-limit store (else in-memory)
REDIS_URL=

# Optional — bot-speed / TTL knobs
CAPTCHA_MIN_SOLVE_MS=800
# CAPTCHA_MAX_SOLVE_MS=300000

# ── Nepal Pay playground (optional; server-only) ─────────────────────────────
# Prefer env over client body secrets. Docs routes may accept body.secretKey
# for local demos — do not expose those patterns in production apps.
ESEWA_SECRET=
KHALTI_SECRET=

CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_PASSWORD=
# Base64-encoded PFX or PEM for ConnectIPS signing
CONNECTIPS_PFX_BASE64=
CONNECTIPS_PFX_PASSWORD=
CONNECTIPS_PEM=
