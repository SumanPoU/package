{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["apps/registry"],
  "workspaces": {
    ".": {
      "entry": [
        "src/app/**/{page,layout,loading,error,not-found,template,default,route}.{ts,tsx}",
        "src/app/**/opengraph-image.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "entry": ["src/index.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": [
    "@base-ui/react",
    "@itzsa/nepal-geo-data",
    "shadcn",
    "tw-animate-css",
    "tailwindcss"
  ],
  "ignoreBinaries": ["openssl"],
  "ignoreIssues": {
    "src/components/ui/checkbox.tsx": ["files"],
    "src/components/ui/select.tsx": ["files"],
    "src/components/ui/table.tsx": ["files"],
    "src/styles/brand.ts": ["files"],
    "packages/captcha/package.json": ["devDependencies"],
    "packages/nepali-input/package.json": ["devDependencies"],
    "packages/page-builder/package.json": ["devDependencies"]
  }
}
