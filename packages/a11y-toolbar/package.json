{
  "name": "@itzsa/a11y-toolbar",
  "version": "0.1.0",
  "description": "Accessible React preference toolbar — text size, contrast, motion, read aloud (TTS), WCAG chrome, FOUC-safe SSR",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "./src/styles.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "development": "./src/headless.ts",
      "import": "./dist/headless.mjs",
      "require": "./dist/headless.js",
      "default": "./dist/headless.mjs"
    },
    "./browser": {
      "default": "./dist/a11y-toolbar.min.js"
    },
    "./styles.css": "./src/styles.css",
    "./a11y-toolbar.min.css": "./dist/a11y-toolbar.min.css",
    "./a11y-toolbar.min.js": "./dist/a11y-toolbar.min.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "IMPLEMENTATION.md",
    "BEHAVIOR.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsup && node ./scripts/prepend-use-client.mjs && tsup --config tsup.browser.ts && node ./scripts/minify-css.mjs && node ./scripts/sync-cdn.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "toolbar",
    "wcag",
    "read-aloud",
    "text-to-speech",
    "preferences",
    "react",
    "wordpress",
    "cdn",
    "dyslexia",
    "contrast-mode",
    "itzsa"
  ],
  "homepage": "https://itzsa.acharya-suman.com.np/a11y-toolbar",
  "bugs": {
    "url": "https://github.com/SumanPoU/package/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SumanPoU/package.git",
    "directory": "packages/a11y-toolbar"
  }
}
