# Postgres (server / cron)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# AES-256 key for encrypt-at-rest (64-char hex preferred, or long passphrase)
METAL_RATE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Cron route: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-long-random-secret"

# Optional: require Bearer for public read API (leave empty = public read)
# METAL_RATE_API_KEY="optional-read-api-key"

# Optional FeNeGoSiDA overrides (server ingest only)
# FENEGOSIDA_API_URL="https://api.fenegosida.org/api/website/v1/Dashboard/WeeklyChartRate?weekmonthyear=7"
# FENEGOSIDA_SCRAPE_URL="https://www.fenegosida.org/"
